# Copy this file to .env and fill in your real values. .env is gitignored.

PORT=3000

# --- Allowance rates (INR per unit) ---
RATE_SHIFT_PER_DAY=250
RATE_TRANSPORT_PER_DAY=300
RATE_ONCALL_PER_DAY=750

# --- SMTP settings used to send the monthly report email ---
# Example for Gmail: host smtp.gmail.com, port 587, secure=false,
# user = your Gmail address, pass = a 16-character Gmail "App Password"
# (not your normal password - create one at https://myaccount.google.com/apppasswords).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Sender shown on the email. Defaults to SMTP_USER if left blank.
FROM_EMAIL=

# The mailbox that should receive the monthly report.
RECIPIENT_EMAIL=

# Cron expression (minute hour day month weekday) for when the monthly
# email fires. Default = 09:00 on the 1st of every month.
CRON_SCHEDULE=0 9 1 * *

# IANA timezone used to evaluate CRON_SCHEDULE.
TZ_NAME=Asia/Kolkata
